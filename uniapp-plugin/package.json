{
  "name": "Uni Face Capture",
  "id": "uni-face-capture",
  "version": "1.1.0",
  "description": "Android 原生竖屏人脸拍照，支持双指缩放、前后摄像头切换及正方形裁切。",
  "_dp_type": "nativeplugin",
  "_dp_nativeplugin": {
    "android": {
      "plugins": [
        {
          "type": "module",
          "name": "uni-face-capture",
          "class": "io.github.unifacecapture.FaceCaptureModule"
        }
      ],
      "integrateType": "aar",
      "minSdkVersion": 21,
      "compileOptions": {
        "sourceCompatibility": "1.8",
        "targetCompatibility": "1.8"
      },
      "abis": ["armeabi-v7a", "arm64-v8a"]
    }
  }
}
